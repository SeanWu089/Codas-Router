name: Windows qualified stable artifact

# Install this file only on the separate qualified-release branch after the
# physical Windows acceptance report exists. This workflow never publishes.
on:
  push:
    branches:
      - 'release/windows-qualified-*'

permissions:
  contents: read
  actions: read

env:
  STABLE_DIRECTORY: Codas-Windows-0.2.0
  STABLE_VERSION: windows-0.2.0
  QUALIFICATION_FILE: releases/windows-0.2.0-qualification.json

jobs:
  artifact:
    name: Build the qualified Windows artifact
    if: github.event_name == 'push' && startsWith(github.ref, 'refs/heads/release/windows-qualified-')
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22.23.3'
      - name: Restore the verified original transport Git objects
        run: node scripts/windows/stable/restore-frozen-source.mjs

      - name: Verify actual qualification and its successful candidate CI
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          node --input-type=module - <<'JS'
          import fs from 'node:fs';
          import path from 'node:path';
          import crypto from 'node:crypto';
          import { execFileSync } from 'node:child_process';
          import { qualificationGate, TRANSPORT_REVISION } from './scripts/windows/stable/build-package.mjs';
          const fail = message => { throw new Error(message); };
          const sha256 = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
          const repository = process.env.GITHUB_REPOSITORY;
          const sourceCommit = process.env.GITHUB_SHA;
          if (!/^[A-Za-z0-9][A-Za-z0-9_.-]*\/[A-Za-z0-9][A-Za-z0-9_.-]*$/.test(repository || '') || !/^[a-f0-9]{40}$/.test(sourceCommit || '')) fail('Invalid repository or source revision.');
          if (process.version !== 'v22.23.3') fail('The exact Node 22.23.3 build toolchain is required.');
          const reportPath = process.env.QUALIFICATION_FILE;
          if (reportPath !== 'releases/windows-0.2.0-qualification.json') fail('Unexpected qualification report path.');
          const info = fs.lstatSync(reportPath);
          if (!info.isFile() || info.isSymbolicLink() || info.size > 8 * 1024 * 1024) fail('Qualification report must be a bounded regular file.');
          const reportBytes = fs.readFileSync(reportPath);
          const report = JSON.parse(reportBytes.toString('utf8'));
          const testedRevision = report.testedEngineeringRevision;
          const runId = report.validatedCIRunId;
          if (!/^[a-f0-9]{40}$/.test(testedRevision || '') || !Number.isSafeInteger(runId) || runId < 1) fail('The report must identify the actual tested engineering SHA and successful candidate CI run ID.');
          // This checks the passed daily-use schema now. The builder later checks
          // these report pins against the freshly reconstructed package bytes.
          const qualification = qualificationGate(report, {
            mode: 'stable', transportRevision: TRANSPORT_REVISION,
            manifestSha256: report.manifestSha256,
            sourceFiles: report.sourceFiles, installerFiles: report.installerFiles,
          });
          if (qualification.stable !== true) fail('Physical Windows usage-scenario qualification is incomplete.');
          execFileSync('git', ['cat-file', '-e', `${testedRevision}^{commit}`]);
          execFileSync('git', ['merge-base', '--is-ancestor', testedRevision, sourceCommit]);
          if (execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim() !== sourceCommit) fail('Checkout differs from the requested immutable source commit.');
          const protectedPaths = [
            'src', 'dependencies', 'package.json', 'package-lock.json', 'LICENSE',
            'scripts/windows/stable/build-package.mjs',
            'scripts/windows/stable/restore-frozen-source.mjs',
            'scripts/windows/stable/INSTALL.cmd',
            'scripts/windows/stable/runtime', 'scripts/windows/stable/installer',
            'test', '.github/workflows/windows-stable-validation.yml',
            '.github/scripts/windows-draft-release.mjs',
            '.github/scripts/windows-draft-release.test.mjs',
          ];
          const changed = execFileSync('git', ['diff', '--name-only', testedRevision, sourceCommit, '--', ...protectedPaths], { encoding: 'utf8' }).trim();
          if (changed) fail(`Product, dependency, builder or validation inputs differ from the tested revision: ${changed}`);
          if (execFileSync('git', ['status', '--porcelain', '--untracked-files=no'], { encoding: 'utf8' }).trim()) fail('Tracked checkout files changed before qualification validation.');
          if (!process.env.GH_TOKEN) fail('Read-only GitHub Actions authentication is missing.');
          const get = async endpoint => {
            const response = await fetch(`https://api.github.com/repos/${repository}/${endpoint}`, {
              method: 'GET', redirect: 'error', signal: AbortSignal.timeout(60000),
              headers: { Authorization: `Bearer ${process.env.GH_TOKEN}`, Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2026-03-10', 'User-Agent': 'CodasQualifiedWindowsArtifact' },
            });
            if (!response.ok) fail(`Read-only candidate CI lookup failed: HTTP ${response.status}.`);
            return response.json();
          };
          const run = await get(`actions/runs/${runId}`);
          const sameRepository = value => typeof value === 'string' && value.toLowerCase() === repository.toLowerCase();
          if (run.id !== runId || run.status !== 'completed' || run.conclusion !== 'success' || run.head_sha !== testedRevision || !['push', 'workflow_dispatch'].includes(run.event) || !/^release\/windows-stable-/.test(run.head_branch || '') || !sameRepository(run.repository?.full_name) || !sameRepository(run.head_repository?.full_name) || !Number.isSafeInteger(run.run_attempt) || run.run_attempt < 1 || !Number.isSafeInteger(run.workflow_id) || run.workflow_id < 1) fail('The referenced CI run is not a successful same-repository candidate run for the exact tested engineering revision.');
          if (report.validatedCIRunAttempt !== undefined && report.validatedCIRunAttempt !== run.run_attempt) fail('The recorded candidate CI attempt differs from the successful run.');
          const workflow = await get(`actions/workflows/${run.workflow_id}`);
          if (workflow.path !== '.github/workflows/windows-stable-validation.yml') fail('The referenced run belongs to a different workflow.');
          const listing = await get(`actions/runs/${runId}/jobs?filter=latest&per_page=100`);
          if (!Array.isArray(listing.jobs) || listing.total_count !== listing.jobs.length) fail('Candidate job inventory is incomplete or unexpectedly large.');
          const requiredNames = [
            'Windows / Node 22.23.3 / PowerShell 5.1',
            'Windows / Node 24.21.0 / PowerShell 5.1',
            'Build complete offline candidate',
            'Attach candidate to an unpublished draft only',
          ];
          const requiredJobs = requiredNames.map(name => {
            const matches = listing.jobs.filter(job => job.name === name);
            if (matches.length !== 1 || matches[0].status !== 'completed' || matches[0].conclusion !== 'success' || matches[0].run_id !== runId) fail(`Required candidate CI job did not complete successfully: ${name}`);
            return { id: matches[0].id, name, conclusion: matches[0].conclusion };
          });
          // Refuse an overlapping rerun rather than mixing attempts in provenance.
          const finalRun = await get(`actions/runs/${runId}`);
          if (finalRun.status !== 'completed' || finalRun.conclusion !== 'success' || finalRun.head_sha !== testedRevision || finalRun.run_attempt !== run.run_attempt) fail('Candidate CI changed while its evidence was being checked.');
          const provenance = {
            schemaVersion: 1, repository, sourceCommit,
            testedEngineeringRevision: testedRevision,
            validatedCIRunId: runId, validatedCIRunAttempt: run.run_attempt,
            validatedCIWorkflow: workflow.path, validatedCIJobs: requiredJobs,
            sourceQualificationFileSha256: sha256(reportBytes),
            qualificationSha256: qualification.reportSha256,
            manifestSha256: report.manifestSha256,
            transportRevision: TRANSPORT_REVISION,
            productInputsUnchangedFromTestedRevision: true,
            protectedPaths,
          };
          fs.writeFileSync(path.join(process.env.RUNNER_TEMP, 'codas-qualified-source.json'), JSON.stringify(provenance, null, 2) + '\n', { flag: 'wx' });
          process.stdout.write(`Validated daily-use report and candidate CI run ${runId}; product inputs are unchanged.\n`);
          JS

      - uses: actions/cache@v4
        with:
          path: ${{ runner.temp }}/codas-windows-archives
          key: codas-windows-archives-${{ hashFiles('dependencies/windows-runtime-pins.json', 'dependencies/windows-devspace-package-lock.json', 'dependencies/npm-integrity-supplement.json') }}
      - name: Fetch and verify exact upstream archives
        shell: bash
        run: |
          node scripts/windows/stable/build-package.mjs --prepare-dependencies --official-only \
            --cache "$RUNNER_TEMP/codas-windows-archives"
      - name: Build the exact qualified stable payload without downloads
        shell: bash
        run: |
          mkdir -p "$RUNNER_TEMP/codas-windows-stable-dist"
          node scripts/windows/stable/build-package.mjs --stable --offline \
            --version "$STABLE_VERSION" --qualification "$QUALIFICATION_FILE" \
            --cache "$RUNNER_TEMP/codas-windows-archives" \
            --output "$RUNNER_TEMP/codas-windows-stable-package/$STABLE_DIRECTORY"

      - name: Archive and verify the short outer package tree
        shell: bash
        run: |
          python3 - <<'PY'
          import os, pathlib, stat, subprocess, time, zipfile
          name = os.environ['STABLE_DIRECTORY']
          root = pathlib.Path(os.environ['RUNNER_TEMP']) / 'codas-windows-stable-package' / name
          target = pathlib.Path(os.environ['RUNNER_TEMP']) / 'codas-windows-stable-dist' / (name + '.zip')
          if (root / 'payload').exists() or not (root / 'payload.codas').is_file():
              raise SystemExit('Expected the compact offline package without an unpacked payload tree.')
          epoch = int(subprocess.check_output(['git', 'show', '-s', '--format=%ct', os.environ['GITHUB_SHA']], text=True))
          date = time.gmtime(max(epoch, 315532800))[:6]
          members = []
          with zipfile.ZipFile(target, 'x', compression=zipfile.ZIP_DEFLATED, compresslevel=6, allowZip64=True) as archive:
              for source in sorted(root.rglob('*')):
                  if source.is_symlink():
                      raise SystemExit('Package contains a symbolic link.')
                  if source.is_dir():
                      continue
                  if not source.is_file():
                      raise SystemExit('Package contains a non-regular file.')
                  member = name + '/' + source.relative_to(root).as_posix()
                  if len(member) > 180:
                      raise SystemExit('Outer package tree is unexpectedly deep.')
                  info = zipfile.ZipInfo(member, date)
                  info.create_system = 3
                  info.external_attr = (stat.S_IFREG | 0o644) << 16
                  info.compress_type = zipfile.ZIP_DEFLATED
                  with source.open('rb') as incoming, archive.open(info, 'w', force_zip64=True) as outgoing:
                      while chunk := incoming.read(1024 * 1024):
                          outgoing.write(chunk)
                  members.append(member)
          with zipfile.ZipFile(target) as archive:
              if archive.namelist() != members or archive.testzip() is not None:
                  raise SystemExit('ZIP round-trip verification failed.')
              for filename in ['release.json', 'payload-manifest.json', 'qualification.json']:
                  if archive.read(name + '/' + filename) != (root / filename).read_bytes():
                      raise SystemExit('ZIP qualification metadata differs from the verified package.')
          print(f'ZIP verified: {len(members)} short outer files.')
          PY

      - name: Pin stable metadata and SHA-256 checksums
        shell: bash
        run: |
          node --input-type=module - <<'JS'
          import fs from 'node:fs';
          import path from 'node:path';
          import crypto from 'node:crypto';
          import { execFileSync } from 'node:child_process';
          const temp = process.env.RUNNER_TEMP;
          const root = path.join(temp, 'codas-windows-stable-package', process.env.STABLE_DIRECTORY);
          const directory = path.join(temp, 'codas-windows-stable-dist');
          const provenance = JSON.parse(fs.readFileSync(path.join(temp, 'codas-qualified-source.json'), 'utf8'));
          const sha256 = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
          const hashFile = async filename => { const hash = crypto.createHash('sha256'); for await (const chunk of fs.createReadStream(filename)) hash.update(chunk); return hash.digest('hex'); };
          const releaseBytes = fs.readFileSync(path.join(root, 'release.json'));
          const release = JSON.parse(releaseBytes.toString('utf8'));
          const manifestBytes = fs.readFileSync(path.join(root, 'payload-manifest.json'));
          const qualificationBytes = fs.readFileSync(path.join(root, 'qualification.json'));
          const qualification = JSON.parse(qualificationBytes.toString('utf8'));
          if (release.schemaVersion !== 1 || release.versionId !== 'windows-0.2.0' || release.qualification?.stable !== true || release.qualification?.status !== 'passed' || release.qualification?.policy?.id !== 'windows-daily-use' || release.payloadArchive?.format !== 'codas-payload-v1' || release.transportRevision !== provenance.transportRevision || release.manifestSha256 !== provenance.manifestSha256 || release.manifestSha256 !== sha256(manifestBytes) || release.qualification.reportSha256 !== sha256(qualificationBytes) || sha256(qualificationBytes) !== provenance.qualificationSha256 || qualification.testedEngineeringRevision !== provenance.testedEngineeringRevision || qualification.validatedCIRunId !== provenance.validatedCIRunId) throw new Error('Stable package does not match the validated physical-PC qualification and prior candidate CI.');
          if (sha256(fs.readFileSync(process.env.QUALIFICATION_FILE)) !== provenance.sourceQualificationFileSha256) throw new Error('Source qualification report changed after validation.');
          if (execFileSync('git', ['status', '--porcelain', '--untracked-files=no'], { encoding: 'utf8' }).trim()) throw new Error('Tracked source changed during stable assembly.');
          const zipName = `${process.env.STABLE_DIRECTORY}.zip`;
          const zipPath = path.join(directory, zipName);
          const zipStat = fs.lstatSync(zipPath);
          if (!zipStat.isFile() || zipStat.isSymbolicLink() || zipStat.size < 4 || zipStat.size > 1024 * 1024 * 1024) throw new Error('Unexpected stable ZIP asset.');
          const archive = { name: zipName, size: zipStat.size, sha256: await hashFile(zipPath) };
          for (const name of ['release.json', 'payload-manifest.json', 'qualification.json']) fs.copyFileSync(path.join(root, name), path.join(directory, name), fs.constants.COPYFILE_EXCL);
          const metadata = {
            ...provenance, versionId: release.versionId,
            stableBuildRunId: process.env.GITHUB_RUN_ID,
            stableBuildRunAttempt: process.env.GITHUB_RUN_ATTEMPT,
            builder: { node: process.version, zlib: process.versions.zlib, platform: process.platform, arch: process.arch },
            qualification: { stable: true, status: 'passed', policy: release.qualification.policy },
            archive, delivery: 'Actions artifact only', published: false,
          };
          fs.writeFileSync(path.join(directory, 'stable-build.json'), JSON.stringify(metadata, null, 2) + '\n', { flag: 'wx' });
          const files = [zipName, 'release.json', 'payload-manifest.json', 'qualification.json', 'stable-build.json'];
          const checksums = [];
          for (const name of files) checksums.push(`${await hashFile(path.join(directory, name))}  ${name}`);
          fs.writeFileSync(path.join(directory, 'SHA256SUMS'), checksums.join('\n') + '\n', { flag: 'wx' });
          if (JSON.stringify(fs.readdirSync(directory).sort()) !== JSON.stringify([...files, 'SHA256SUMS'].sort())) throw new Error('Unexpected stable artifact inventory.');
          process.stdout.write(JSON.stringify({ qualified: true, published: false, archive, metadataFiles: files.slice(1) }) + '\n');
          if (process.env.GITHUB_STEP_SUMMARY) fs.appendFileSync(process.env.GITHUB_STEP_SUMMARY, `### Qualified Windows artifact\n\nSource commit: \`${provenance.sourceCommit}\`\n\nTested engineering commit: \`${provenance.testedEngineeringRevision}\` · successful candidate CI: \`${provenance.validatedCIRunId}\`\n\nSHA-256: \`${archive.sha256}\`\n\nThe six-file Actions artifact is ready for authenticated download. This workflow does not create, upload to, or publish a GitHub release.\n`);
          JS

      - name: Preserve the qualified artifact for authenticated download
        id: stable_artifact
        uses: actions/upload-artifact@v4
        with:
          name: Codas-Windows-0.2.0-${{ github.sha }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/codas-windows-stable-dist/*
          if-no-files-found: error
          compression-level: 0
          retention-days: 30

# All GitHub API calls above use GET with actions:read. Artifact upload uses the
# Actions artifact service; no contents:write, release API or Git ref mutation.
# https://docs.github.com/en/rest/actions/workflow-runs#get-a-workflow-run
# https://docs.github.com/en/rest/actions/workflow-jobs#list-jobs-for-a-workflow-run
# https://github.com/actions/upload-artifact
